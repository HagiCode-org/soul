---
import GoogleAnalytics from "@hagicode/hagilight-core/GoogleAnalytics"
import Analytics51LA from "@hagicode/hagilight-core/Analytics51LA"
import PromotoBanner from "@hagicode/hagilight-core/PromotoBanner"
import { resolveFaviconHeadEntry } from "@hagicode/hagilight-core/favicon"
import sharedFaviconUrl from "@hagicode/hagilight-core/favicon.ico"
import SEOHead from "@hagicode/hagilight/SEOHead"
import Footer from "@hagicode/hagilight/Footer"
import SoulApp from "@/components/SoulApp"
import { DEFAULT_LOCALE, SUPPORTED_LOCALES, type AppLocale } from "@/i18n/locales"
import "@/index.css"

const initialLocale = DEFAULT_LOCALE
const secondaryLocales = SUPPORTED_LOCALES.filter((locale) => locale !== initialLocale)

const soulSiteId = "soul-builder"
const soulSiteUrl = "https://soul.hagicode.com"

const soulDescription = "HagiSoul gives developers a faster workspace for creating, sharing, and browsing Souls."
const soulTitle = "HagiSoul: Agent Soul Editor"

const soulStructuredData = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "HagiSoul",
  url: `${soulSiteUrl}/`,
  description: soulDescription,
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Web",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "CNY",
  },
  author: {
    "@type": "Organization",
    name: "HagiCode",
    url: "https://hagicode.com",
  },
};

// The bundled HagiCode icon, emitted by Astro from the package asset. hagilightFavicon() writes to the
// Astro config head, which this page does not render, so the same entry is supplied here.
const faviconEntry = resolveFaviconHeadEntry([], { href: sharedFaviconUrl });

const soulHeadEntries = [
  ...(faviconEntry ? [faviconEntry] : []),
  { tag: "meta", attrs: { name: "theme-color", content: "#0f4c5c" } },
  { tag: "meta", attrs: { name: "robots", content: "index, follow" } },
  { tag: "meta", attrs: { name: "author", content: "HagiCode" } },
  {
    tag: "meta",
    attrs: {
      name: "keywords",
      content: "HagiSoul, Soul 编辑器, Agent Soul, AI 角色设定, prompt builder, HagiCode, AI agent, character builder",
    },
  },
  { tag: "meta", attrs: { property: "og:type", content: "website" } },
  { tag: "meta", attrs: { property: "og:url", content: `${soulSiteUrl}/` } },
  { tag: "meta", attrs: { property: "og:site_name", content: "HagiSoul" } },
  { tag: "meta", attrs: { property: "og:locale", content: "en_US" } },
  { tag: "meta", attrs: { property: "og:locale:alternate", content: "zh_CN" } },
  { tag: "meta", attrs: { name: "twitter:card", content: "summary_large_image" } },
];

const soulFooterLinks = {
  siteId: soulSiteId,
  siteUrl: soulSiteUrl,
  overrides: {
    icpFiling: {
      label: "闽ICP备2026004153号-1",
      href: "https://beian.miit.gov.cn/",
      external: true,
    },
    publicSecurityFiling: {
      label: "闽公网安备35011102351148号",
      href: "http://www.beian.gov.cn/portal/registerSystemInfo",
      external: true,
    },
  },
  extraLinks: {
    community: [
      {
        id: "soul-email",
        label: "Email",
        href: "mailto:support@hagicode.com",
        external: true,
      },
      {
        id: "soul-steam",
        label: "Steam",
        href: "https://store.steampowered.com/app/4625540/Hagicode/",
        external: true,
      },
    ],
  },
};
---

<!doctype html>
<html lang={initialLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{soulTitle}</title>
    <SEOHead
      page={{
        url: `${soulSiteUrl}/`,
        title: soulTitle,
        description: soulDescription,
      }}
      head={soulHeadEntries}
      structuredData={soulStructuredData}
    />

    <!-- Google Analytics 4 -->
    <GoogleAnalytics measurementId="G-EN03FMT2Q4" />
    <Analytics51LA siteId={import.meta.env.VITE_51LA_ID || "L6b88a5yK4h2Xnci"} />
  </head>
  <body>
    <SoulApp client:load />

    <PromotoBanner locale={initialLocale} />
    <Footer locale={initialLocale} links={soulFooterLinks} />

    {secondaryLocales.map((locale: AppLocale) => (
      <template data-locale={locale}>
        <Footer locale={locale} links={soulFooterLinks} />
      </template>
    ))}

    <script is:inline define:vars={{ defaultLanguage: initialLocale }}>
      (() => {
        const root = document.documentElement;
        const footer = document.querySelector('footer.hagilight-footer');
        const banner = document.querySelector('hagilight-promoto-banner');
        const footerForLocale = (locale) =>
          document.querySelector(`template[data-locale="${locale}"]`)?.content.querySelector('footer');
        const applyLocale = (locale) => {
          if (!locale) return;
          if (footer) {
            const replacement = footerForLocale(locale) || footerForLocale(defaultLanguage);
            if (replacement) footer.innerHTML = replacement.innerHTML;
            footer.dataset.locale = locale;
          }
          if (banner) {
            banner.dataset.locale = locale;
            document.dispatchEvent(new Event('astro:page-load'));
          }
        };
        applyLocale(root.lang || defaultLanguage);
        new MutationObserver(() => applyLocale(root.lang || defaultLanguage)).observe(root, {
          attributes: true,
          attributeFilter: ['lang'],
        });
      })();
    </script>
  </body>
</html>
